// Serves index.html on http://localhost:8642 so the browser remembers the microphone permission.
const http = require('http');
const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

const PORT = 8642;
const page = path.join(__dirname, 'index.html');

http.createServer((req, res) => {
  fs.readFile(page, (err, body) => {
    if (err) { res.writeHead(500); res.end('index.html introuvable'); return; }
    res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Cache-Control': 'no-store' });
    res.end(body);
  });
}).listen(PORT, '127.0.0.1', () => {
  const url = `http://localhost:${PORT}/`;
  console.log(`Le Souffleur est ouvert sur ${url} (fermez cette fenêtre pour l'arrêter)`);
  exec(`start "" msedge ${url}`, (e) => { if (e) exec(`start "" ${url}`); });
});
